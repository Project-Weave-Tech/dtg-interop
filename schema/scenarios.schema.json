{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Project-Weave-Tech/dtg-interop/schema/scenarios.schema.json",
  "title": "DTG interop scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layers",
    "scenarios",
    "statusWords"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "asks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "asks": {
            "type": "string",
            "maxLength": 200,
            "description": "The question the layer asks, one sentence."
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "layer",
          "title",
          "asks",
          "requires",
          "done",
          "origin"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "layer": {
            "type": "string",
            "description": "A layer id."
          },
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "asks": {
            "type": "string",
            "maxLength": 300,
            "description": "What the scenario is about, one sentence."
          },
          "requires": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 240
            },
            "description": "What a project brings to take part, one line each. Name the side (\"Both apps:\", \"Issuing side:\") when the sides differ. A project's status at the scenario says how far it meets these."
          },
          "done": {
            "type": "string",
            "maxLength": 400,
            "description": "What has to happen between two projects for the scenario to count as run. A procedure is a recipe for exactly this; a passing result is the proof."
          },
          "origin": {
            "type": "string",
            "maxLength": 200,
            "description": "Where the scenario comes from: a deck, a one-pager, a task force, a project."
          },
          "weaveLevel": {
            "type": "string",
            "maxLength": 4,
            "description": "The level in the Project Weave deck, if the scenario comes from there."
          },
          "derivedFrom": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "match"
            ],
            "description": "How the build fills a project's status at this scenario from its detail fields when the project has not said more than stated: an entry of `field` with status runs that matches every key in `match` makes the point runs (derived), with that entry's evidence.",
            "properties": {
              "field": {
                "enum": [
                  "credentials",
                  "messaging",
                  "replication",
                  "trustTaskUse"
                ]
              },
              "match": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "description": "Key of the entry → accepted values. A string value must be one of them; an array value must contain one of them."
              }
            }
          },
          "candidate": {
            "type": "string",
            "maxLength": 240,
            "description": "An open question about the scenario itself: a proposal to merge it into another scenario or to drop it, with the reason. Removed when decided."
          }
        }
      }
    },
    "statusWords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stated",
        "runs",
        "vectors",
        "spec",
        "open",
        "n/a"
      ],
      "properties": {
        "runs": {
          "type": "string"
        },
        "vectors": {
          "type": "string"
        },
        "spec": {
          "type": "string"
        },
        "open": {
          "type": "string"
        },
        "n/a": {
          "type": "string"
        },
        "stated": {
          "type": "string"
        }
      }
    },
    "shown": {
      "type": "string",
      "description": "One sentence on how the board derives that a scenario has run between two projects."
    }
  }
}
