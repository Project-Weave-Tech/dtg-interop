{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/real-life-org/dtg-interop/schema/trust-tasks.schema.json",
  "title": "Trust Task types a project uses, extracted from its source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extracted",
    "method",
    "sources",
    "types"
  ],
  "properties": {
    "extracted": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "method": {
      "type": "string",
      "maxLength": 400
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "uniqueItems": true
    }
  }
}
