{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Project-Weave-Tech/dtg-interop/schema/project.schema.json",
  "title": "DTG interop project row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "repositories",
    "stack",
    "scenarios",
    "provenance",
    "updated"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
      "description": "Folder name under projects/."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "shortName": {
      "type": "string",
      "maxLength": 16,
      "description": "Short form for tight places, as the project itself uses it. Omit when the name is short enough."
    },
    "purpose": {
      "type": "string",
      "maxLength": 160,
      "description": "One sentence on what the project sets out to do, in its own words. Omit rather than guess."
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "docs": {
      "type": "string",
      "format": "uri"
    },
    "logo": {
      "description": "Square logo or icon of the project: a URL the project publishes itself (its website or its GitHub account), or the file name of a logo kept in site/ (logo-<slug>.png). The board falls back to initials when absent.",
      "type": "string",
      "format": "uri-reference"
    },
    "licence": {
      "type": "string",
      "maxLength": 160,
      "description": "In the project's words; the build also shows the licence GitHub reports per repository."
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "label",
          "url"
        ],
        "properties": {
          "kind": {
            "enum": [
              "android",
              "ios",
              "web",
              "desktop",
              "cli",
              "simulator",
              "other"
            ]
          },
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "enum": [
              "live",
              "alpha",
              "prototype"
            ]
          }
        }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "didMethods": {
          "type": "string"
        },
        "credentials": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        },
        "trustTasks": {
          "type": "string"
        },
        "groups": {
          "type": "string"
        },
        "devices": {
          "type": "string"
        }
      }
    },
    "requiredParty": {
      "type": "string",
      "description": "The party without which the implementation does not work."
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9-]{1,40}$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "stated",
                "runs",
                "vectors",
                "spec",
                "open",
                "n/a"
              ]
            },
            "note": {
              "type": "string",
              "maxLength": 400
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "url"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "date"
      ],
      "properties": {
        "kind": {
          "enum": [
            "project",
            "public"
          ],
          "description": "project: written or confirmed by the project. public: compiled from public sources by someone else."
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Comparable short values for the projects table; the free-text stack stays for the project sheet.",
      "properties": {
        "didMethods": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "status"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "status": {
                    "enum": [
                      "runs",
                      "building",
                      "committed"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "url"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "description": "Short values; an empty list means none, a missing key means not known. A value with a status is an object { value, status }; a plain string has no status stated."
        },
        "keys": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "status"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "status": {
                    "enum": [
                      "runs",
                      "building",
                      "committed"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "url"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "description": "Short values; an empty list means none, a missing key means not known. A value with a status is an object { value, status }; a plain string has no status stated."
        },
        "trustTasks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "status"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "status": {
                    "enum": [
                      "runs",
                      "building",
                      "committed"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "url"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "description": "Short values; an empty list means none, a missing key means not known. A value with a status is an object { value, status }; a plain string has no status stated."
        },
        "groupAuthority": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "status"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "status": {
                    "enum": [
                      "runs",
                      "building",
                      "committed"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "url"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "description": "Short values; an empty list means none, a missing key means not known. A value with a status is an object { value, status }; a plain string has no status stated."
        },
        "groupKeys": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "status"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "status": {
                    "enum": [
                      "runs",
                      "building",
                      "committed"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "url"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "description": "Short values; an empty list means none, a missing key means not known. A value with a status is an object { value, status }; a plain string has no status stated."
        },
        "offline": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "status"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "status": {
                    "enum": [
                      "runs",
                      "building",
                      "committed"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "url"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "description": "Short values; an empty list means none, a missing key means not known. A value with a status is an object { value, status }; a plain string has no status stated."
        },
        "language": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "status"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "status": {
                    "enum": [
                      "runs",
                      "building",
                      "committed"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "url"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "description": "Short values; an empty list means none, a missing key means not known. A value with a status is an object { value, status }; a plain string has no status stated."
        }
      }
    },
    "credentials": {
      "type": "array",
      "description": "One entry per credential form. An empty list means none; a missing key means not known.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "status"
        ],
        "properties": {
          "model": {
            "enum": [
              "W3C VC 2.0",
              "W3C VC 1.1",
              "W3C VC (version not stated)",
              "SD-JWT VC",
              "ACDC",
              "JLINC agreement",
              "flat JSON (fpp-poc)"
            ],
            "description": "Data model or format."
          },
          "profiles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 60
            },
            "description": "Credential types carried; keys of credential-profiles.json."
          },
          "proof": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "eddsa-jcs-2022",
                "eddsa-rdfc-2022",
                "ecdsa-jcs-2019",
                "JWS EdDSA",
                "KERI signatures"
              ]
            },
            "description": "Proof suites; empty where the format brings its own (SD-JWT VC)."
          },
          "status": {
            "enum": [
              "runs",
              "building",
              "committed"
            ],
            "description": "runs: in running code. building: code exists, not complete. committed: announced or agreed, nothing running yet."
          },
          "note": {
            "type": "string",
            "maxLength": 300
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "messaging": {
      "type": "array",
      "description": "Messages between parties: one entry per protocol and carrier. An empty list means none; a missing key means not known.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol",
          "via",
          "status"
        ],
        "properties": {
          "protocol": {
            "enum": [
              "TSP 1.0",
              "TSP (version not stated)",
              "DIDComm v2",
              "HTTPS",
              "WebRTC",
              "Reticulum",
              "Nostr",
              "BLE"
            ]
          },
          "via": {
            "enum": [
              "direct",
              "mediator",
              "app server",
              "host",
              "peers (DHT)",
              "mesh",
              "key-blind carrier"
            ],
            "description": "Kind of carrier."
          },
          "viaName": {
            "type": "string",
            "maxLength": 80,
            "description": "The concrete carrier, e.g. VTI mediator."
          },
          "status": {
            "enum": [
              "runs",
              "building",
              "committed"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 300
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "replication": {
      "type": "array",
      "description": "Shared state between parties or devices: one entry per mechanism and carrier. An empty list means none; a missing key means not known.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol",
          "via",
          "status"
        ],
        "properties": {
          "protocol": {
            "enum": [
              "MLS",
              "Perspective Diff Sync (Holochain)",
              "RLTP replication",
              "HTTPS",
              "CRDT ledger",
              "signed hash chain",
              "event log",
              "bundle replication"
            ]
          },
          "via": {
            "enum": [
              "direct",
              "mediator",
              "app server",
              "host",
              "peers (DHT)",
              "mesh",
              "key-blind carrier"
            ],
            "description": "Kind of carrier."
          },
          "viaName": {
            "type": "string",
            "maxLength": 80,
            "description": "The concrete carrier, e.g. VTI mediator."
          },
          "status": {
            "enum": [
              "runs",
              "building",
              "committed"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 300
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "trustTaskUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "description": "Which Trust Task types the project uses, where they come from, and how far along it is. A missing key means not known.",
      "properties": {
        "status": {
          "enum": [
            "runs",
            "building",
            "committed",
            "none"
          ],
          "description": "runs: in running code. building: code exists, not complete. committed: announced or agreed, nothing running yet. none: uses no Trust Tasks."
        },
        "note": {
          "type": "string",
          "maxLength": 400
        },
        "namespaces": {
          "type": "array",
          "description": "Where the types come from.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "kind"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 60
              },
              "prefix": {
                "type": "string",
                "maxLength": 120
              },
              "kind": {
                "enum": [
                  "registry",
                  "own"
                ]
              }
            }
          }
        },
        "types": {
          "type": "array",
          "description": "Type URIs without version; a trailing /* stands for a whole family. An object entry overrides the status for one type.",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "status"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "status": {
                    "enum": [
                      "runs",
                      "building",
                      "committed",
                      "none"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            ]
          }
        },
        "typesFile": {
          "const": "trust-tasks.json",
          "description": "Long type lists live in projects/<slug>/trust-tasks.json (extracted from the source)."
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "How many types, where the list itself is not public."
        },
        "mapsTo": {
          "type": "object",
          "description": "Own type mapped to a registry type.",
          "additionalProperties": {
            "type": "string",
            "maxLength": 200
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "documentProof": {
          "type": "array",
          "description": "What secures the Trust Task documents themselves (not credentials).",
          "items": {
            "enum": [
              "Data Integrity eddsa-jcs-2022",
              "pairwise MAC"
            ]
          }
        }
      }
    }
  }
}
