{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Project-Weave-Tech/dtg-interop/schema/runs.schema.json",
  "title": "DTG interop runs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runs"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subjects",
          "date",
          "sides",
          "outcome"
        ],
        "properties": {
          "subjects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "credential",
                    "task",
                    "ceremony",
                    "basic"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "outcome": {
                  "enum": [
                    "pass",
                    "fail",
                    "partial"
                  ],
                  "description": "Only when this subject's outcome differs from the run's."
                }
              }
            }
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "sides": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project",
                "version"
              ],
              "properties": {
                "project": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              }
            }
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "partial"
            ]
          },
          "source": {
            "enum": [
              "manual",
              "ci"
            ],
            "description": "Missing means manual."
          },
          "note": {
            "type": "string",
            "maxLength": 800
          },
          "protocol": {
            "type": "string",
            "format": "uri"
          },
          "vectors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "reportedBy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project"
            ],
            "properties": {
              "project": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "url"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
